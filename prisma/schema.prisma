generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  vehicles     Vehicle[]
  expenses     Expense[]
  reminders    Reminder[]
  subscription Subscription?
  aiResults    AIAnalysisResult[]
}

enum UserRole {
  USER
  ADMIN
}

model Vehicle {
  id             String     @id @default(uuid())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  plate          String?
  brand          String
  model          String
  year           Int
  currentMileage Int
  vin            String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  expenses       Expense[]
  reminders      Reminder[]
  aiResults      AIAnalysisResult[]
}

enum ExpenseType {
  FUEL
  MAINTENANCE
  INSURANCE
  TAX
  REPAIR
  OTHER
}

enum ExpenseSource {
  MANUAL
  OCR
  AI_ADJUSTED
}

model Expense {
  id               String        @id @default(uuid())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  vehicle          Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId        String
  type             ExpenseType
  amount           Decimal       @db.Decimal(10, 2)
  currency         String
  date             DateTime
  mileageAtExpense Int?
  notes            String?
  source           ExpenseSource @default(MANUAL)
  attachments      Attachment[]
}

model Attachment {
  id               String   @id @default(uuid())
  expense          Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId        String
  fileUrl          String
  originalFileName String
  mimeType         String
  createdAt        DateTime @default(now())
}

enum ReminderType {
  INSPECTION
  INSURANCE
  TAX
  MAINTENANCE
  CUSTOM
}

model Reminder {
  id          String       @id @default(uuid())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId   String
  type        ReminderType
  dueDate     DateTime
  isCompleted Boolean      @default(false)
  completedAt DateTime?
  description String?
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  FLEET_SMALL
  FLEET_MEDIUM
  FLEET_LARGE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  TRIAL
}

model Subscription {
  id        String              @id @default(uuid())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String              @unique
  plan      SubscriptionPlan    @default(FREE)
  status    SubscriptionStatus  @default(TRIAL)
  startedAt DateTime            @default(now())
  expiresAt DateTime?
}

model AIAnalysisResult {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId      String
  timeRangeStart DateTime?
  timeRangeEnd   DateTime?
  summaryText    String
  extraData      Json
  createdAt      DateTime @default(now())
}
